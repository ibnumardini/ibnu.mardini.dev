---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile, type NoteCategory } from '../data/profile';

// full class strings so Tailwind can see them
const noteColors: Record<NoteCategory, string> = {
	quote: 'bg-accent',
	snippet: 'bg-amber-100',
	config: 'bg-rose-100',
};

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const pinnedProjects = profile.projects.filter((project) => project.pinned);
---

<Layout title={`${profile.name} - ${profile.title}`}>
	<section class="relative py-16">
		<div
			aria-hidden="true"
			class="bg-accent pointer-events-none absolute top-0 -left-24 -z-10 h-96 w-96 rounded-full opacity-60 blur-3xl dark:opacity-7"
		>
		</div>
		<div
			aria-hidden="true"
			class="bg-accent pointer-events-none absolute top-24 -left-10 -z-10 h-64 w-64 rounded-full opacity-60 blur-3xl dark:opacity-7"
		>
		</div>
		<h1 class="font-heading text-4xl font-bold sm:text-5xl">
			Wassup? <span class="motion-safe:animate-wave inline-block origin-[70%_70%]">👋🏼</span>
		</h1>
		<p class="mt-4 text-slate-600 dark:text-slate-300">
			I'm <strong class="font-heading font-semibold text-slate-900 dark:text-slate-100">{profile.name}</strong> (aka. <span
				class="font-hand mr-0.5 text-[1.35em] leading-none font-semibold text-slate-900 dark:text-slate-100"
				>{profile.username}</span
			>), a software engineer from Yogyakarta, Indonesia
			<Icon
				name="flag-id"
				class="ml-1 inline-block h-[0.8em] w-[1.2em] rounded-xs align-[-0.05em] ring-1 ring-slate-300 dark:ring-slate-600"
			/>.<br />
			I spend my days on APIs and my nights wondering why they broke.
		</p>
		<div class="mt-6 flex flex-wrap gap-3">
			<a
				href="/about"
				class="inline-flex items-center gap-2 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
			>
				More about me
				<Icon name="tabler:arrow-right" size={18} />
			</a>
			<a
				href={profile.cvUrl}
				class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-100 dark:border-slate-600 dark:text-white dark:hover:bg-slate-800"
			>
				<Icon name="tabler:download" size={18} />
				Download CV
			</a>
		</div>
		<div class="mt-6">
			<SocialLinks size={22} />
		</div>
	</section>

	<p
		id="local-status"
		class="mb-5 flex w-fit items-center gap-2 rounded-md border border-slate-200 bg-white/60 px-3 py-1 text-xs text-slate-600 backdrop-blur dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300"
	>
		<span class="relative flex h-1.5 w-1.5">
			<span data-ping class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75 motion-reduce:hidden"></span>
			<span data-dot class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
		</span>
		<span data-text>Right Now I'm Probably Coding 💻</span>
	</p>

	<blockquote
		class="border-accent mb-6 rounded-r-md border-l-2 bg-slate-50 py-2 pl-4 font-mono text-sm text-slate-500 dark:bg-slate-900 dark:text-slate-400"
	>
		if err := beNice(); err != nil {'{'} beKind() {'}'}
	</blockquote>

	<section id="projects" class="py-10">
		<div class="flex items-baseline justify-between">
			<h2 class="font-heading text-xl font-semibold">Featured Projects</h2>
			<a href="/projects" class="text-sm hover:underline">View all &rarr;</a>
		</div>
		<div class="mt-4 grid gap-4 sm:grid-cols-2">
			{pinnedProjects.map((project) => <ProjectCard {...project} />)}
		</div>
	</section>

	<section class="py-10">
		<div class="flex items-baseline justify-between">
			<h2 class="font-heading text-xl font-semibold">Recent Post</h2>
			<a href="/blog" class="text-sm hover:underline">View all &rarr;</a>
		</div>
		<div class="mt-4 space-y-4">
			{
				posts.map((post) => (
					<BlogCard
						id={post.id}
						title={post.data.title}
						date={post.data.date}
						description={post.data.description}
						language={post.data.language}
						cover={post.data.cover}
					/>
				))
			}
		</div>
	</section>

	<section class="py-10">
		<h2 class="font-heading text-xl font-semibold">Elsewhere</h2>
		<ul class="mt-4 space-y-4">
			{
				profile.elsewhere.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3">
							<Icon
								name={link.icon}
								size={20}
								class="shrink-0 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300"
							/>
							<span>
								<span class="font-semibold text-slate-900 underline underline-offset-2 dark:text-white">
									{link.title}
								</span>
								<span class="text-sm text-slate-500 dark:text-slate-400"> &middot; {link.description}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section
		id="board"
		aria-labelledby="board-title"
		class="relative mx-[calc(50%-50vw)] mt-10 mb-10 max-h-75 min-h-25 cursor-grab [&:fullscreen]:max-h-none touch-none overflow-hidden border-y active:cursor-grabbing border-slate-200 bg-slate-50 bg-[radial-gradient(var(--color-slate-300)_1px,transparent_1px)] bg-size-[16px_16px] dark:border-slate-800 dark:bg-slate-900 dark:bg-[radial-gradient(var(--color-slate-700)_1px,transparent_1px)]"
	>
		<h2 id="board-title" class="font-heading pt-8 text-center text-xl font-semibold select-none">Notes to Self</h2>
		<div id="board-content" class="mx-auto flex max-w-3xl flex-wrap items-start justify-center gap-4 px-6 pt-6 pb-8">
			{
				profile.notes.map((note, i) => (
					<p
						data-note
						class:list={[noteColors[note.category], 'relative max-w-56 cursor-grab touch-none rounded-xs px-3 py-2 font-mono text-xs whitespace-pre-wrap text-slate-700 shadow-md select-none active:cursor-grabbing']}
						style={`rotate: ${[-2, 1.5, -1, 2][i % 4]}deg`}
					>
						{/* one line: whitespace-pre-wrap would render source indentation */}
						<span class="mb-1 flex justify-between gap-3 text-[10px] text-slate-400"><span>#{String(i + 1).padStart(2, '0')}</span><span class="flex items-center gap-1.5">{note.category}<button type="button" data-copy={note.text} aria-label="Copy note" title="Copy" class="cursor-pointer hover:text-slate-700"><Icon name="tabler:copy" size={12} /><Icon name="tabler:check" size={12} class="hidden" /></button></span></span>{note.text}
					</p>
				))
			}
		</div>
		<div class="absolute right-5 bottom-3 z-9999 flex gap-2">
			{
				[
					{ id: 'board-reset', label: 'Reset note positions', icon: 'tabler:restore' },
					{ id: 'board-fullscreen', label: 'Toggle fullscreen', icon: 'tabler:maximize' },
				].map((btn) => (
					<button
						type="button"
						id={btn.id}
						aria-label={btn.label}
						title={btn.label}
						class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800"
					>
						<Icon name={btn.icon} size={16} />
					</button>
				))
			}
		</div>
	</section>
</Layout>

<script>
	// ponytail: moods hardcoded by WIB hour; move to profile.ts if it ever changes
	let timer: ReturnType<typeof setInterval> | undefined;
	const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
	// [fromHour, label, awake] — first entry whose fromHour <= current hour wins (checked from the end)
	const moods: [number, string, boolean][] = [
		[0, 'Dreaming in TypeScript 😴', false],
		[4, 'Sleeping, Do Not Deploy 💤', false],
		[7, 'Booting Up, Need Coffee ☕', true],
		[9, 'Pretending to Be Productive 💻', true],
		[12, 'Hunting for Nasi Gudeg 🍛', true],
		[13, 'Fighting Post-Lunch Coma 😵‍💫', true],
		[16, 'Fixing Bugs I Made This Morning 🐛', true],
		[19, 'Eating at Angkringan 🍢', true],
		[21, 'Pushing One More Commit, I Swear 🌙', true],
		[23, 'Supposed to Be Asleep 🦉', true],
	];

	function render() {
		const el = document.getElementById('local-status');
		if (!el) return;
		const time = fmt.format(new Date());
		const hour = Number(time.slice(0, 2));
		const [, label, awake] = moods.findLast(([from]) => from <= hour)!;
		el.querySelector('[data-text]')!.textContent = `Right Now I'm ${label}`;
		el.querySelector('[data-dot]')!.className = `relative inline-flex h-1.5 w-1.5 rounded-full ${awake ? 'bg-emerald-500' : 'bg-slate-400'}`;
		el.querySelector('[data-ping]')!.classList.toggle('hidden', !awake);
	}

	document.addEventListener('astro:page-load', () => {
		clearInterval(timer);
		if (!document.getElementById('local-status')) return;
		render();
		timer = setInterval(render, 30_000);
	});

	document.addEventListener('astro:page-load', () => {
		const board = document.getElementById('board');
		if (!board) return;
		let z = 1;
		const resets: (() => void)[] = [];
		board.querySelectorAll<HTMLElement>('[data-note]').forEach((note) => {
			let x = 0;
			let y = 0;
			resets.push(() => {
				x = y = 0;
				note.style.translate = note.style.zIndex = '';
			});
			note.onpointerdown = (e) => {
				// capture would swallow the copy button's click
				if ((e.target as HTMLElement).closest('button')) return;
				note.setPointerCapture(e.pointerId);
				note.style.zIndex = String(++z);
				const [sx, sy] = [e.clientX - x, e.clientY - y];
				note.onpointermove = (e) => {
					x = e.clientX - sx;
					y = e.clientY - sy;
					note.style.translate = `${x}px ${y}px`;
				};
				note.onpointerup = () => (note.onpointermove = null);
			};
		});

		const content = document.getElementById('board-content')!;
		let px = 0;
		let py = 0;
		const pan = () => {
			content.style.translate = board.style.backgroundPosition = px || py ? `${px}px ${py}px` : '';
		};
		board.onpointerdown = (e) => {
			if ((e.target as HTMLElement).closest('[data-note], button')) return;
			board.setPointerCapture(e.pointerId);
			const [sx, sy] = [e.clientX - px, e.clientY - py];
			board.onpointermove = (e) => {
				px = e.clientX - sx;
				py = e.clientY - sy;
				pan();
			};
			board.onpointerup = () => (board.onpointermove = null);
		};
		resets.push(() => {
			px = py = 0;
			pan();
		});

		document.getElementById('board-reset')!.onclick = () => resets.forEach((reset) => reset());

		board.onclick = async (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
			if (!btn) return;
			await navigator.clipboard.writeText(btn.dataset.copy!);
			const [copy, check] = btn.querySelectorAll('svg');
			copy.classList.add('hidden');
			check.classList.remove('hidden');
			setTimeout(() => (copy.classList.remove('hidden'), check.classList.add('hidden')), 1500);
		};
		const fullscreen = document.getElementById('board-fullscreen')!;
		fullscreen.hidden = !document.fullscreenEnabled;
		fullscreen.onclick = () => (document.fullscreenElement ? document.exitFullscreen() : board.requestFullscreen());
	});
</script>
