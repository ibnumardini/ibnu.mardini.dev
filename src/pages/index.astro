---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile, type NoteCategory } from '../data/profile';
import heroCalm from '../assets/hero-calm.jpg';
import heroCalmDark from '../assets/hero-calm-dark.jpg';

// full class strings so Tailwind can see them
const noteColors: Record<NoteCategory, string> = {
	quote: 'bg-accent',
	snippet: 'bg-amber-100',
	config: 'bg-rose-100',
};

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const pinnedProjects = profile.projects.filter((project) => project.pinned);
---

<Layout title={`${profile.name} - ${profile.title}`}>
	<section class="relative pt-18.5 pb-7 sm:pt-30 sm:pb-18.5">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2 overflow-hidden"
		>
			<Image
				src={heroCalm}
				alt=""
				loading="eager"
				fetchpriority="high"
				widths={[800, 1280, 1920]}
				sizes="100vw"
				class="h-full w-full -scale-x-100 object-cover object-[80%_80%] sm:object-[right_75%] dark:hidden"
			/>
			<Image
				src={heroCalmDark}
				alt=""
				loading="eager"
				fetchpriority="high"
				widths={[800, 1280, 1920]}
				sizes="100vw"
				class="hidden h-full w-full -scale-x-100 object-cover object-[80%_80%] opacity-80 sm:object-[right_75%] dark:block"
			/>
			<div
				class="absolute inset-0 bg-linear-to-l from-white/55 via-white/35 to-white/30 sm:from-white/70 sm:via-white/25 sm:to-white/20 dark:from-slate-950/55 dark:via-slate-950/50 dark:to-slate-950/65 sm:dark:from-slate-950/25 sm:dark:via-slate-950/45 sm:dark:to-slate-950/60"
			>
			</div>
			<div
				class="absolute inset-0 bg-linear-to-b from-white/20 via-transparent to-white dark:from-slate-950/25 via-transparent dark:to-slate-950"
			>
			</div>
		</div>
		<p
			id="local-status"
			class="mb-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-slate-600 sm:mb-3 dark:text-slate-400"
		>
			<span data-dot aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-emerald-500"></span>
			<span data-time>WIB</span>
			<span aria-hidden="true">&middot;</span>
			<span data-text>Right now I'm probably coding</span>
		</p>
		<h1 class="font-heading text-3xl font-bold sm:text-5xl">
			<span id="greeting">Wassup?</span>
			<span class="motion-safe:animate-wave inline-block origin-[70%_70%]">👋🏼</span>
		</h1>
		<script is:inline>
			(() => {
				const g = [
					'Wassup?',
					'Hey there!',
					'Yo, yo!',
					'Howdy!',
					'Hello, world!',
					'Halo!',
					'Sup?',
					"What's good?",
				];
				document.getElementById('greeting').textContent = g[Math.floor(Math.random() * g.length)];
			})();
		</script>
		<p class="mt-3 text-sm leading-relaxed text-pretty text-slate-700 sm:mt-4 sm:text-base dark:text-slate-300">
			I'm <strong class="font-heading font-semibold text-slate-900 dark:text-slate-100">{profile.name}</strong> (aka.
			<span class="font-hand mr-0.5 text-[1.35em] leading-none font-semibold text-slate-900 dark:text-slate-100"
				>{profile.username}</span
			>), a software engineer from Yogyakarta, Indonesia
			<Icon
				name="flag-id"
				class="ml-1 inline-block h-[0.8em] w-[1.2em] rounded-xs align-[-0.05em] ring-1 ring-slate-300 dark:ring-slate-600"
			/>.<br class="hidden sm:inline" />
			I spend my days on APIs and my nights wondering why they broke.
		</p>
		<div class="mt-5 flex flex-col items-start gap-4 sm:mt-6 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5 sm:gap-y-3">
			<div class="flex flex-wrap gap-2.5 sm:gap-3">
				<a
					href="/about"
					class="inline-flex min-h-11 items-center gap-2 rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-700 sm:min-h-0 sm:py-2 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
				>
					About & experience
					<Icon name="tabler:arrow-right" size={18} />
				</a>
				<a
					href={profile.cvUrl}
					class="inline-flex min-h-11 items-center gap-2 rounded-md border border-slate-300 bg-white/70 px-4 py-2.5 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-100 sm:min-h-0 sm:py-2 dark:border-slate-600 dark:bg-slate-950/60 dark:text-white dark:hover:bg-slate-800"
				>
					<Icon name="tabler:download" size={18} />
					Download CV
				</a>
			</div>
			<SocialLinks size={22} />
		</div>
	</section>

	<section id="projects" class="py-11.5">
		<div class="flex items-baseline justify-between">
			<h2 class="font-heading text-xl font-semibold">Featured Projects</h2>
			<a href="/projects" class="text-sm hover:underline">All projects &rarr;</a>
		</div>
		<div class="mt-4 grid gap-4 sm:grid-cols-2">
			{pinnedProjects.map((project) => <ProjectCard {...project} />)}
		</div>
	</section>

	<section class="py-11.5">
		<div class="flex items-baseline justify-between">
			<h2 class="font-heading text-xl font-semibold">Recent Posts</h2>
			<a href="/blog" class="text-sm hover:underline">All posts &rarr;</a>
		</div>
		<div class="mt-4 space-y-4">
			{
				posts.map((post) => (
					<BlogCard
						id={post.id}
						title={post.data.title}
						date={post.data.date}
						description={post.data.description}
						language={post.data.language}
						cover={post.data.cover}
					/>
				))
			}
		</div>
	</section>

	<section class="py-11.5">
		<h2 class="font-heading text-xl font-semibold">Elsewhere</h2>
		<ul class="mt-4 space-y-4">
			{
				profile.elsewhere.map((link) => (
					<li>
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3"
						>
							<Icon
								name={link.icon}
								size={20}
								class="shrink-0 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300"
							/>
							<span>
								<span class="font-semibold text-slate-900 underline underline-offset-2 dark:text-white">
									{link.title}
								</span>
								<span class="text-sm text-slate-500 dark:text-slate-400">
									{' '}
									&middot; {link.description}
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section
		id="board"
		aria-labelledby="board-title"
		class="relative mx-[calc(50%-50vw)] mt-11.5 mb-11.5 max-h-75 min-h-25 cursor-grab touch-none overflow-hidden border-y border-slate-200 bg-slate-50 bg-[radial-gradient(var(--color-slate-300)_1px,transparent_1px)] bg-size-[16px_16px] py-8 active:cursor-grabbing dark:border-slate-800 dark:bg-slate-900 dark:bg-[radial-gradient(var(--color-slate-700)_1px,transparent_1px)] [&:fullscreen]:flex [&:fullscreen]:max-h-none [&:fullscreen]:flex-col [&:fullscreen]:justify-center"
	>
		<h2 id="board-title" class="font-heading text-center text-xl leading-none font-semibold select-none">
			Notes to Self
		</h2>
		<div
			id="board-content"
			class="mx-auto mt-5 flex max-w-3xl flex-wrap items-start justify-center gap-4 px-6 pb-1.5"
		>
			{
				profile.notes.map((note, i) => (
					<p
						data-note
						class:list={[
							noteColors[note.category],
							'relative max-w-56 cursor-grab touch-none rounded-xs px-3 py-2 font-mono text-xs whitespace-pre-wrap text-slate-700 shadow-md select-none active:cursor-grabbing',
						]}
						style={`rotate: ${[-2, 1.5, -1, 2][i % 4]}deg`}
					>
						{/* one line: whitespace-pre-wrap would render source indentation */}
						<span class="mb-1 flex justify-between gap-3 text-[10px] text-slate-400">
							<>
								<span>#{String(i + 1).padStart(2, '0')}</span>
								<span class="flex items-center gap-1.5">
									{note.category}
									<button
										type="button"
										data-copy={note.text}
										aria-label="Copy note"
										title="Copy"
										class="cursor-pointer hover:text-slate-700"
									>
										<>
											<Icon name="tabler:copy" size={12} />
											<Icon name="tabler:check" size={12} class="hidden" />
										</>
									</button>
								</span>
							</>
						</span>
						{note.text}
					</p>
				))
			}
		</div>
		<div class="absolute right-5 bottom-3 z-9999 flex gap-2">
			{
				[
					{ id: 'board-reset', label: 'Reset note positions', icon: 'tabler:restore' },
					{ id: 'board-fullscreen', label: 'Toggle fullscreen', icon: 'tabler:maximize' },
				].map((btn) => (
					<button
						type="button"
						id={btn.id}
						aria-label={btn.label}
						title={btn.label}
						class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800"
					>
						<Icon name={btn.icon} size={16} />
					</button>
				))
			}
		</div>
	</section>
</Layout>

<script>
	// ponytail: moods hardcoded by WIB hour; move to profile.ts if it ever changes
	let timer: ReturnType<typeof setInterval> | undefined;
	const fmt = new Intl.DateTimeFormat('en-GB', {
		timeZone: 'Asia/Jakarta',
		hour: '2-digit',
		minute: '2-digit',
		hourCycle: 'h23',
	});
	// [fromHour, label, awake] — first entry whose fromHour <= current hour wins (checked from the end)
	const moods: [number, string, boolean][] = [
		[0, 'dreaming in TypeScript.', false],
		[4, 'sleeping, do not deploy.', false],
		[7, 'booting up, need coffee.', true],
		[9, 'pretending to be productive.', true],
		[12, 'hunting for nasi gudeg.', true],
		[13, 'fighting a post-lunch coma.', true],
		[16, 'fixing bugs I made this morning.', true],
		[19, 'eating at angkringan.', true],
		[21, 'pushing one more commit, I swear.', true],
		[23, 'supposed to be asleep.', true],
	];

	function render() {
		const el = document.getElementById('local-status');
		if (!el) return;
		const time = fmt.format(new Date());
		const hour = Number(time.slice(0, 2));
		const [, label, awake] = moods.findLast(([from]) => from <= hour)!;
		el.querySelector('[data-time]')!.textContent = `${time} WIB`;
		el.querySelector('[data-text]')!.textContent = `Right now I'm ${label}`;
		el.querySelector('[data-dot]')!.className =
			`inline-block h-2 w-2 shrink-0 rounded-full ${awake ? 'bg-emerald-500' : 'bg-slate-400'}`;
	}

	document.addEventListener('astro:page-load', () => {
		clearInterval(timer);
		if (!document.getElementById('local-status')) return;
		render();
		timer = setInterval(render, 30_000);
	});

	document.addEventListener('astro:page-load', () => {
		const board = document.getElementById('board');
		if (!board) return;
		let z = 1;
		const resets: (() => void)[] = [];
		board.querySelectorAll<HTMLElement>('[data-note]').forEach((note) => {
			let x = 0;
			let y = 0;
			resets.push(() => {
				x = y = 0;
				note.style.translate = note.style.zIndex = '';
			});
			note.onpointerdown = (e) => {
				// capture would swallow the copy button's click
				if ((e.target as HTMLElement).closest('button')) return;
				note.setPointerCapture(e.pointerId);
				note.style.zIndex = String(++z);
				const [sx, sy] = [e.clientX - x, e.clientY - y];
				note.onpointermove = (e) => {
					x = e.clientX - sx;
					y = e.clientY - sy;
					note.style.translate = `${x}px ${y}px`;
				};
				note.onpointerup = () => (note.onpointermove = null);
			};
		});

		const content = document.getElementById('board-content')!;
		let px = 0;
		let py = 0;
		const pan = () => {
			content.style.translate = board.style.backgroundPosition = px || py ? `${px}px ${py}px` : '';
		};
		board.onpointerdown = (e) => {
			if ((e.target as HTMLElement).closest('[data-note], button')) return;
			board.setPointerCapture(e.pointerId);
			const [sx, sy] = [e.clientX - px, e.clientY - py];
			board.onpointermove = (e) => {
				px = e.clientX - sx;
				py = e.clientY - sy;
				pan();
			};
			board.onpointerup = () => (board.onpointermove = null);
		};
		resets.push(() => {
			px = py = 0;
			pan();
		});

		document.getElementById('board-reset')!.onclick = () => resets.forEach((reset) => reset());

		board.onclick = async (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
			if (!btn) return;
			await navigator.clipboard.writeText(btn.dataset.copy!);
			const [copy, check] = btn.querySelectorAll('svg');
			copy.classList.add('hidden');
			check.classList.remove('hidden');
			setTimeout(() => (copy.classList.remove('hidden'), check.classList.add('hidden')), 1500);
		};
		const fullscreen = document.getElementById('board-fullscreen')!;
		fullscreen.hidden = !document.fullscreenEnabled;
		fullscreen.onclick = () => (document.fullscreenElement ? document.exitFullscreen() : board.requestFullscreen());
	});
</script>
