---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const pinnedProjects = profile.projects.filter((project) => project.pinned);
---

<Layout title={`${profile.name} - ${profile.title}`}>
	<section class="relative py-16">
		<div
			aria-hidden="true"
			class="bg-accent pointer-events-none absolute top-0 -left-24 -z-10 h-96 w-96 rounded-full opacity-40 blur-3xl dark:opacity-10"
		>
		</div>
		<div
			aria-hidden="true"
			class="bg-accent pointer-events-none absolute top-24 -left-10 -z-10 h-64 w-64 rounded-full opacity-30 blur-3xl dark:opacity-5"
		>
		</div>
		<h1 class="font-heading text-4xl font-bold sm:text-5xl">Wassup? 👋🏼</h1>
		<p class="mt-4 text-slate-600 dark:text-slate-300">
			I'm {profile.name} (aka. {profile.username}), a software engineer from Indonesia
			<Icon
				name="flag-id"
				class="ml-1 inline-block h-[0.8em] w-[1.2em] rounded-[2px] align-[-0.05em] ring-1 ring-slate-300 dark:ring-slate-600"
			/><br />
			I spend my days on APIs and my nights wondering why they broke.
		</p>
		<div class="mt-6 flex flex-wrap gap-3">
			<a
				href="/about"
				class="inline-flex items-center gap-2 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
			>
				Get to know me
				<Icon name="tabler:arrow-right" size={18} />
			</a>
			<a
				href={profile.cvUrl}
				class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-100 dark:border-slate-600 dark:text-white dark:hover:bg-slate-800"
			>
				<Icon name="tabler:download" size={18} />
				Download CV
			</a>
		</div>
		<div class="mt-6">
			<SocialLinks size={22} />
		</div>
	</section>

	<blockquote
		class="border-accent mb-6 rounded-r-md border-l-2 bg-slate-50 py-2 pl-4 font-mono text-sm text-slate-500 dark:bg-slate-900 dark:text-slate-400"
	>
		if err := beNice(); err != nil {'{'} beKind() {'}'}
	</blockquote>

	<section id="projects" class="py-10">
		<div class="flex items-baseline justify-between">
			<h2 class="font-heading text-xl font-semibold">Featured Projects</h2>
			<a href="/projects" class="text-sm hover:underline">View all &rarr;</a>
		</div>
		<div class="mt-4 grid gap-4 sm:grid-cols-2">
			{pinnedProjects.map((project) => <ProjectCard {...project} />)}
		</div>
	</section>

	<section class="py-10">
		<div class="flex items-baseline justify-between">
			<h2 class="font-heading text-xl font-semibold">Recent Post</h2>
			<a href="/blog" class="text-sm hover:underline">View all &rarr;</a>
		</div>
		<div class="mt-4 space-y-4">
			{
				posts.map((post) => (
					<BlogCard
						id={post.id}
						title={post.data.title}
						date={post.data.date}
						description={post.data.description}
						language={post.data.language}
					/>
				))
			}
		</div>
	</section>

	<section class="py-10">
		<h2 class="font-heading text-xl font-semibold">Elsewhere</h2>
		<ul class="mt-4 space-y-4">
			{
				profile.elsewhere.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3">
							<Icon
								name={link.icon}
								size={20}
								class="shrink-0 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300"
							/>
							<span>
								<span class="font-semibold text-slate-900 underline underline-offset-2 dark:text-white">
									{link.title}
								</span>
								<span class="text-sm text-slate-500 dark:text-slate-400"> &middot; {link.description}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
