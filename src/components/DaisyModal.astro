---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import daisy from '../assets/daisy.jpg';
---

<div
	id="daisy-modal"
	class="fixed inset-0 z-50 hidden items-center justify-center border-b border-slate-200/80 bg-white/70 opacity-0 backdrop-blur-lg transition-opacity duration-200 dark:border-slate-800/80 dark:bg-slate-950/70"
>
	<div id="daisy-panel" class="max-w-lg scale-95 px-6 transition-transform duration-200">
		<div class="mb-6 flex w-full justify-center">
			<button
				id="daisy-close"
				aria-label="Close"
				class="flex cursor-pointer items-center justify-center rounded-full bg-slate-900 p-2 text-white shadow-lg transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
			>
				<Icon name="tabler:x" size={16} />
			</button>
		</div>
		<Image
			src={daisy}
			alt="A field of daisies"
			widths={[400, 800]}
			sizes="(min-width: 768px) 512px, 100vw"
			class="w-full rounded-lg object-cover"
		/>
		<p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
			Daisies don't need to stand out alone. In their lush little clusters, they complement one another and create a small world full of joy. 🌼
		</p>
	</div>
</div>

<script>
	function initDaisyModal() {
		const modal = document.getElementById('daisy-modal');
		const panel = document.getElementById('daisy-panel');
		const trigger = document.querySelector('[data-daisy-trigger]');
		const closeBtn = document.getElementById('daisy-close');
		if (!modal || !panel || !trigger || !closeBtn) return;

		const toggle = (show: boolean) => {
			if (show) {
				modal.classList.remove('hidden');
				modal.classList.add('flex');
				requestAnimationFrame(() => {
					modal.classList.remove('opacity-0');
					panel.classList.remove('scale-95');
				});
				document.body.style.overflow = 'hidden';
			} else {
				modal.classList.add('opacity-0');
				panel.classList.add('scale-95');
				document.body.style.overflow = '';
				setTimeout(() => {
					modal.classList.add('hidden');
					modal.classList.remove('flex');
				}, 200);
			}
		};

		trigger.addEventListener('click', () => toggle(true));
		closeBtn.addEventListener('click', () => toggle(false));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') toggle(false);
		});
	}

	initDaisyModal();
	document.addEventListener('astro:after-swap', initDaisyModal);
</script>
