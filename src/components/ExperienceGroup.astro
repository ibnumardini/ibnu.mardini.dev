---
import type { ExperienceEntry } from '../data/profile';

interface Props {
	company: string;
	companyUrl?: string;
	positions: ExperienceEntry[];
}

const { company, companyUrl, positions } = Astro.props;
---

<div
	class="dark:hover:border-accent border-l-2 border-slate-200 py-2 pl-4 transition-colors duration-200 hover:border-slate-400 dark:border-slate-800"
>
	<h3 class="font-semibold">
		{
			companyUrl ? (
				<a href={companyUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
					{company}
				</a>
			) : (
				company
			)
		}
	</h3>
	<div class="mt-2 space-y-3">
		{
			positions.map((position) => (
				<div>
					<div class="flex flex-wrap items-baseline justify-between gap-x-4">
						<span class="text-sm font-medium">{position.role}</span>
						<span class="text-sm text-slate-500 dark:text-slate-400">{position.dates}</span>
					</div>
					<ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-600 dark:text-slate-300">
						{position.bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</div>
