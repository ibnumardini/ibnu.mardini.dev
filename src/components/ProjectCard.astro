---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/profile';

type Props = Project & { filterable?: boolean };

const { title, description, tags, repoUrl, liveUrl, images, type, filterable = false } = Astro.props;
const gallerySlug = images?.[0]?.src.split('/')[0];

const screenshots = import.meta.glob<ImageMetadata>('/src/assets/project-preview/**/*.{png,jpg,jpeg,webp}', {
	eager: true,
	import: 'default',
});
const cover = images?.[0] && screenshots[`/src/assets/project-preview/${images[0].src}`];

const pastelFill: Record<string, string> = {
	API: 'bg-accent/20 dark:bg-accent/4',
	'CLI App': 'bg-amber-100/25 dark:bg-amber-200/4',
	Library: 'bg-rose-100/25 dark:bg-rose-200/4',
};
const headerFill = !cover && (pastelFill[type] ?? 'bg-accent/20 dark:bg-accent/4');

// on a photo or pastel fill, keep the type badge crisp
const typeClass = cover
	? 'border border-teal-900/15 bg-accent text-slate-800'
	: 'border border-teal-700/20 bg-accent text-slate-800 dark:border-accent/30 dark:bg-accent/15 dark:text-accent';

const tagClass = cover
	? 'border border-slate-300/60 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'
	: 'border border-slate-200/90 bg-white/90 text-slate-600 dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-300';

const iconClass = cover
	? 'pointer-events-auto text-white/70 hover:text-white'
	: 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200';
---

<div
	data-project-card
	data-project-type={type}
	class="dark:hover:border-accent flex flex-col overflow-hidden rounded-lg border border-slate-200 bg-white transition-colors duration-200 hover:border-slate-400 dark:border-slate-800 dark:bg-slate-950"
>
	<div
		class:list={[
			'group relative isolate flex min-h-36 flex-col justify-between gap-4 overflow-hidden border-b border-slate-200 p-5 dark:border-slate-800',
			cover ? 'text-white' : headerFill,
		]}
	>
		{
			cover && (
				<>
					<Image
						src={cover}
						alt=""
						widths={[400, 800]}
						sizes="(min-width: 640px) 400px, 100vw"
						class="absolute inset-0 -z-10 h-full w-full object-cover"
					/>
					<div class="absolute inset-0 -z-10 bg-linear-to-t from-slate-950/75 to-slate-950/50 backdrop-blur-xs transition-opacity duration-300 group-hover:opacity-75" />
					<button
						type="button"
						data-gallery-trigger
						data-gallery-slug={gallerySlug}
						aria-label={`${title} screenshots`}
						class="absolute inset-0 cursor-pointer"
					/>
				</>
			)
		}
		<div class:list={['flex items-center justify-between', cover && 'pointer-events-none relative']}>
			<h3 class="font-semibold">{title}</h3>
			<div class="flex items-center gap-3">
				{
					liveUrl && (
						<a href={liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title} live demo`} class={iconClass}>
							<Icon name="tabler:external-link" size={18} />
						</a>
					)
				}
				<a href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title} source on GitHub`} class={iconClass}>
					<Icon name="tabler:brand-github" size={18} />
				</a>
			</div>
		</div>
		<div class:list={['flex flex-wrap gap-2', cover && 'pointer-events-none relative']}>
			{
				filterable ? (
					<button
						type="button"
						data-project-filter-type={type}
						aria-pressed="false"
						class:list={[typeClass, 'focus-visible:outline-accent pointer-events-auto rounded-full px-2 py-0.5 text-xs transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2']}
					>
						{type}
					</button>
				) : (
					<span class:list={[typeClass, 'rounded-full px-2 py-0.5 text-xs']}>
						{type}
					</span>
				)
			}
			{
				tags.map((tag) => (
					<span class:list={[tagClass, 'rounded-full px-2 py-0.5 text-xs']}>
						{tag}
					</span>
				))
			}
		</div>
	</div>
	<p class="px-5 pt-4 pb-5 text-sm text-pretty text-slate-600 dark:text-slate-300">{description}</p>
</div>
